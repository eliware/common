{
    "name": "@eliware/common",
    "type": "module",
    "version": "2.0.0",
    "description": "An ESM and Node.js compatibility layer for shared Eliware filesystem, path, logging, error, and signal APIs.",
    "types": "index.d.ts",
    "files": [
        "index.mjs",
        "src",
        "index.d.ts",
        "README.md",
        "LICENSE",
        "RELEASE_NOTES.md",
        "examples"
    ],
    "exports": {
        ".": {
            "import": "./index.mjs",
            "types": "./index.d.ts"
        }
    },
    "scripts": {
        "test": "eliware-test",
        "lint": "eliware-test --lint",
        "typecheck": "tsc --project tsconfig.json",
        "pack": "npm pack --dry-run"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/eliware/common.git"
    },
    "keywords": [
        "nodejs",
        "common utilities",
        "logging",
        "path utilities",
        "error handling",
        "signal handling",
        "esm",
        "typescript"
    ],
    "author": "Eli Sterling, eliware.org <eli@eliware.org>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/eliware/common/issues"
    },
    "homepage": "https://github.com/eliware/common#readme",
    "devDependencies": {
        "@eliware/test": "^2.0.0",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "@eliware/errors": "^2.0.0",
        "@eliware/log": "^2.0.0",
        "@eliware/path": "^2.0.0",
        "@eliware/signals": "^2.0.0"
    },
    "engines": {
        "node": ">=26"
    },
    "publishConfig": {
        "access": "public"
    }
}